        visible: !keyPicker.visible && currentPage === 1

        onClicked: {
            console.log("### CRYPTO: BACK TO START ###")
            showStartPage()
        }
    }

    // -------------------------------------------------------------------------
    // Hauptansicht
    // -------------------------------------------------------------------------
    ScrollView {
        id: cryptoScrollView

        visible: !keyPicker.visible && currentPage === 1
        z: 100

        anchors {
            top: parent.top
            left: parent.left
            right: parent.right
            bottom: cryptoBackButton.top

            margins: 0
        }

        clip: true
        ScrollBar.vertical.policy: ScrollBar.AsNeeded

        Column {
            id: cryptoColumn

            width: cryptoScrollView.width - 24
            x: 12

            spacing: 16
            topPadding: 16
            bottomPadding: 36

            // Kopfbereich -----------------------------------------------------
            Rectangle {
                width: parent.width
                height: 105
                radius: 12
                color: "#2c2c2c"

                Column {
                    anchors.left: parent.left
                    anchors.verticalCenter: parent.verticalCenter
                    anchors.leftMargin: 20
                    spacing: 3

                    Text {
                        text: "GPG Text"
                        font.pixelSize: 34
                        font.bold: true
                        color: "white"


                    }

                    Text {
                        text: "OpenPGP text encryption and decryption"
                        font.pixelSize: 25
                        color: "#dddddd"
                        elide: Text.ElideRight
                        width: cryptoColumn.width - 40
                    }
                }
            }


            // Schlüssel ------------------------------------------------------
            Text {
                text: "KEY"
                font.pixelSize: 16
                font.bold: true
                color: "#666666"
                topPadding: 4
            }

            Rectangle {
                width: parent.width
                height: selectedFingerprint === "" ? 145 : 195
                radius: 12
                color: "#f3f3f3"
                border.color: selectedFingerprint === "" ? "#cccccc" : "#d7d7d7"
                border.width: 1

                Column {
                    anchors.fill: parent
                    anchors.margins: 14
                    spacing: 8

                    Text {
                        text: "Encryption Key"
                        font.pixelSize: 25
                        color: "#666666"
                    }

                    ComboBox {
                        id: keyComboBox

                        width: parent.width
                        height: 70
                        z: 200

                        model: keyList
                        textRole: "name"

                        currentIndex: selectedFingerprint === ""
                                      ? -1
                                      : keyList.findIndex(function(k) {
                                            return k.fingerprint === selectedFingerprint
                                        })

                        displayText: currentIndex >= 0 && currentIndex < keyList.length
                                    ? ((keyList[currentIndex].name !== ""
                                        ? keyList[currentIndex].name
                                        : "(no name)") +
                                       (keyList[currentIndex].email !== ""
                                        ? " <" + keyList[currentIndex].email + ">"
                                        : ""))
                                    : "Bitte Select Key ..."

                        font.pixelSize: 30

                        delegate: ItemDelegate {
                            width: keyComboBox.width
                            height: 76

                            contentItem: Column {
                                anchors.fill: parent
                                anchors.margins: 10
                                spacing: 2

                                Text {
                                    text: modelData.name !== ""
                                          ? modelData.name
                                          : "(no name)"
                                    font.pixelSize: 30
                                    font.bold: true
                                    color: "black"
                                    elide: Text.ElideRight
                                    width: parent.width
                                }

                                Text {
                                    text: modelData.email !== ""
                                          ? modelData.email
                                          : "(no email)"
                                    font.pixelSize: 25
                                    color: "#666666"
                                    elide: Text.ElideRight
                                    width: parent.width
                                }
                            }

                            onClicked: {
                                console.log("### KEY SELECTED ###")
                                console.log("### KEY NAME ###", modelData.name)
                                console.log("### KEY EMAIL ###", modelData.email)
                                console.log("### KEY FINGERPRINT ###",
                                            modelData.fingerprint)
                                console.log("### KEY SECRET ###",
                                            modelData.hasSecretKey)

                                selectedFingerprint = modelData.fingerprint
                                keyComboBox.currentIndex = index

                                console.log("### SELECTED FINGERPRINT ###",
                                            selectedFingerprint)
                            }
                        }

                        onCurrentIndexChanged: {
                            if (currentIndex >= 0 &&
                                currentIndex < keyList.length) {

                                selectedFingerprint =
                                    keyList[currentIndex].fingerprint

                                console.log("### KEY COMBO INDEX ###",
                                            currentIndex)
                                console.log("### SELECTED FINGERPRINT ###",
                                            selectedFingerprint)
                            }
                        }
                    }

                    Text {
                        width: parent.width
                        visible: selectedFingerprint !== ""
                        text: {
                            if (selectedFingerprint === "" ||
                                keyComboBox.currentIndex < 0 ||
                                keyComboBox.currentIndex >= keyList.length)
                                return ""

                            var key = keyList[keyComboBox.currentIndex]
                            var name = key.name !== "" ? key.name : "(no name)"
                            var email = key.email !== "" ? " <" + key.email + ">" : ""
                            return "✓ " + name + email
                        }
                        font.pixelSize: 25
                        font.bold: true
                        color: "#333333"
                        elide: Text.ElideRight
                    }

                    Text {
                        width: parent.width
                        visible: selectedFingerprint !== ""
                        text: selectedFingerprint === ""
                              ? ""
                              : "Fingerprint: " + selectedFingerprint
                        font.pixelSize: 32
                        color: "#777777"
                        elide: Text.ElideMiddle
                    }
                }
            }


            Component.onCompleted: {
                console.log("========== CRYPTO LAYOUT DEBUG ==========")
                console.log("ROOT width =", rootRectangle.width)
                console.log("ROOT height =", rootRectangle.height)
                console.log("SCROLL width =", cryptoScrollView.width)
                console.log("SCROLL height =", cryptoScrollView.height)
                console.log("SCROLL availableWidth =", cryptoScrollView.availableWidth)
                console.log("SCROLL contentWidth =", cryptoScrollView.contentWidth)
                console.log("COLUMN width =", cryptoColumn.width)
                console.log("COLUMN height =", cryptoColumn.height)
                console.log("COLUMN parent width =", parent.width)
                console.log("INPUT CONTAINER width =", inputContainer.width)
                console.log("INPUT CONTAINER height =", inputContainer.height)
                console.log("INPUT TEXT width =", inputText.width)
                console.log("INPUT TEXT height =", inputText.height)
                console.log("==========================================")
            }

            // Eingabe --------------------------------------------------------
            Text {
                text: "INPUT"
                font.pixelSize: 32
                Component.onCompleted: console.log("### CRYPTO INPUT LABEL ###", "width=", width, "height=", height, "pixelSize=", font.pixelSize)
                font.bold: true
                color: "#666666"
                topPadding: 4
            }

            Rectangle {
                id: inputContainer
                width: parent.width
                height: 600
                radius: 12
                color: "#fafafa"
                border.color: "#bdbdbd"
                border.width: 1

                TextArea {
                    id: inputText

                    anchors.fill: parent
                    anchors.margins: 12

                    font.pixelSize: 52
                    Component.onCompleted: console.log("### CRYPTO INPUT TEXTAREA ###", "width=", width, "height=", height, "pixelSize=", font.pixelSize)
                    wrapMode: TextArea.Wrap
                    placeholderText: "Enter plaintext or encrypted text ..."
                    color: "black"
                    background: null
                    selectByMouse: true

                    Keys.onPressed: {
                        if ((event.modifiers & Qt.ControlModifier) &&
                            event.key === Qt.Key_C) {

                            copy()
                            event.accepted = true
                            console.log("### INPUT COPIED ###")
                        }
                    }
                }
            }

            // Hauptaktionen --------------------------------------------------
            Row {
                width: parent.width
                spacing: 12

                Button {
                    width: (parent.width - parent.spacing) / 2
                    height: 290
                    text: "🔒  Verschlüsseln"
                    font.pixelSize: 40

                    onClicked: {
                        console.log("### ENCODE BUTTON ###")
                        encodeText()
                    }
                }

                Button {
                    width: (parent.width - parent.spacing) / 2
                    height: 290
                    text: "🔓  Entschlüsseln"
                    font.pixelSize: 40

                    onClicked: {
                        console.log("### DECODE BUTTON ###")
                        decodeText()
                    }
                }
            }

            Row {
                width: parent.width
                spacing: 12

                Button {
                    width: (parent.width - 24) / 3
                    height: 220
                    text: "Copy"
                    font.pixelSize: 40

                    onClicked: {
                        inputText.selectAll()
                        inputText.copy()
                        inputText.deselect()

                        console.log("### INPUT COPY BUTTON ###")
                        console.log("### INPUT COPY LENGTH ###",
                                    inputText.text.length)
                    }
                }

                Button {
                    width: (parent.width - 24) / 3
                    height: 220
                    text: "Paste"
                    font.pixelSize: 40

                    onClicked: {
                        console.log("### INPUT PASTE BUTTON ###")
                        inputText.paste()
                        console.log("### INPUT AFTER PASTE LENGTH ###",
                                    inputText.text.length)
                    }
                }

                Button {
                    width: (parent.width - 24) / 3
                    height: 220
                    text: "Clear"
                    font.pixelSize: 40

                    onClicked: {
                        inputText.clear()
                        console.log("### INPUT CLEAR BUTTON ###")
                    }
                }
            }

            // Ausgabe --------------------------------------------------------
            Text {
                text: "OUTPUT"
                font.pixelSize: 21
                font.bold: true
                color: "#666666"
                topPadding: 8
            }

            Rectangle {
                width: parent.width
                height: 300
                radius: 12
                color: "#f1f1f1"
                border.color: "#c5c5c5"
                border.width: 1

                TextArea {
                    id: output

                    anchors.fill: parent
                    anchors.margins: 12

                    font.pixelSize: 26
                    wrapMode: TextArea.Wrap
                    readOnly: true
                    selectByMouse: true
                    color: "black"
                    background: null

                    Keys.onPressed: {
                        if ((event.modifiers & Qt.ControlModifier) &&
                            event.key === Qt.Key_C) {

                            copy()
                            event.accepted = true
                            console.log("### OUTPUT COPIED ###")
                        }
                    }
                }
            }

            Row {
                width: parent.width
                spacing: 8

                Button {
                    width: (parent.width - parent.spacing * 2) / 3
                    height: 48
                    text: "Copy"
                    font.pixelSize: 25

                    onClicked: {
                        output.selectAll()
                        output.copy()
                        output.deselect()

                        console.log("### OUTPUT COPY BUTTON ###")
                        console.log("### OUTPUT COPY LENGTH ###",
                                    output.text.length)
                    }
                }

                Button {
                    width: (parent.width - parent.spacing * 2) / 3
                    height: 48
                    text: "Paste"
                    font.pixelSize: 25

                    onClicked: {
                        console.log("### OUTPUT PASTE BUTTON ###")
                        output.paste()
                        console.log("### OUTPUT AFTER PASTE LENGTH ###",
                                    output.text.length)
                    }
                }

                Button {
                    width: (parent.width - parent.spacing * 2) / 3
                    height: 48
                    text: "Clear"
                    font.pixelSize: 25

                    onClicked: {
                        output.clear()
                        console.log("### OUTPUT CLEARED ###")
                    }
                }
            }
        }
    }

    Column {
        id: mainColumn
        visible: false

        anchors {
            top: parent.top
            left: parent.left
            right: parent.right
            margins: 30
        }

        spacing: 20

        Button {
            width: parent.width
            height: 60

            text: "Import Key"

            onClicked: {
                console.log("### KEY IMPORT BUTTON ###")
                importKeyDesktopOrTouch()
            }
        }

        Button {
            width: parent.width
            height: 60

            text: "Öffentliche Schlüssel"

            onClicked: {
                console.log("### ÖFFENTLICHE KEY BUTTON ###")

                var keys = gpgBackend.listPublicKeys()

                console.log("### LIST PUBLIC KEYS ERGEBNIS ###", JSON.stringify(keys))

                output.text = JSON.stringify(keys, null, 2)
            }
        }

        Button {
            width: parent.width
            height: 60

            text: "Manage Keys"

            onClicked: {
                console.log("### KEY VERWALTEN BUTTON ###")
                keyManagerPopup.open()
            }
        }
    }

}
